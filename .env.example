# Render panelinde Environment sekmesine bu anahtarları girin (değerler sizde kalır, repoya koymayın)
DISCORD_TOKEN=
CHANNEL_ID=
API_KEY=
ENCRYPTION_KEY=
SITE_PASSWORD=
SITE_SESSION_SECRET=
PORT=3000

# İsteğe bağlı: rol bazlı şifreler (tanımlanmazsa SITE_PASSWORD kullanılır)
KAYIT_PASSWORD=
KONTROL_PASSWORD=
YONETIM_PASSWORD=

# Kayıt/Kontrol ekibinin kayıt silerken gireceği şifre (tanımlanmazsa SITE_PASSWORD)
VISITOR_DELETE_PASSWORD=

# İsteğe bağlı: proxy arkasındaysanız atlama sayısı (Render'da otomatik 1 kabul edilir)
# TRUST_PROXY=1
